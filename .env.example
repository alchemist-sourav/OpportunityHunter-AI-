# ── OpportunityHunter AI — environment template ─────────────────────────
# Copy to ".env" (backend) and adjust. Never commit real values.
# Values below are placeholders only.

# ── Backend core ─────────────────────────────────────────────────────────
APP_NAME=OpportunityHunter AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ── Database (PostgreSQL / Supabase) ─────────────────────────────────────
# Leave empty to run the API without a database (health endpoint still works).
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/opportunity_hunter
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase Auth (JWT verification, server-side only) ───────────────────
# JWT secret from Supabase dashboard > Settings > API > JWT Settings.
# ISSUER should be <YOUR_PROJECT_URL>/auth/v1 if an explicit custom issuer is used.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# ── Firecrawl ────────────────────────────────────────────────────────────
# Server-side only. In Phase 2 each user supplies their own key.
# NEVER set this in frontend code or in NEXT_PUBLIC_ variables.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_SECONDS=30
# Live-validate a user's key against the Firecrawl /health endpoint on save (defaults to format-only check).
FIRECRAWL_VALIDATE_LIVE=false

# ── Credential encryption (Phase 2 per-user encrypted storage) ───────────
# 32-byte hex key, e.g. generated with: openssl rand -hex 32
FIRECRAWL_ENCRYPTION_KEY=

# ── Opportunity discovery (Phase 3) ──────────────────────────────────────
# Per-user limits and safety knobs. Source domains must be a comma-separated
# allowlist; only these hosts may be crawled.
DISCOVERY_MAX_RESULTS=20
DISCOVERY_MAX_CONCURRENT_JOBS=2
DISCOVERY_DAILY_QUOTA=10
DISCOVERY_MAX_DOMAINS=8
DISCOVERY_SUPPORTED_DOMAINS=linkedin.com,wellfound.com,remoteok.com,workatastartup.com,internshala.com,upwork.com,freelancer.com,greenhouse.io,lever.co
DISCOVERY_POLL_SECONDS=5
DISCOVERY_MAX_WAIT_SECONDS=300
DISCOVERY_MAX_RESPONSE_BYTES=200000
DISCOVERY_MAX_STORED_RESULTS=60
DISCOVERY_MAX_RETRIES=2

# ── Frontend ─────────────────────────────────────────────────────────────
# Only public, non-secret values may use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000
