# ── OpportunityHunter AI — Backend Environment Template ────────────────────
# Copy to ".env" in the backend directory.
# All secret values are empty placeholders. Never commit real credentials.

# ── Backend core ───────────────────────────────────────────────────────────
APP_NAME=OpportunityHunter AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# ── Database (PostgreSQL / Supabase) ───────────────────────────────────────
# Optional at startup; leave empty to run without database (health check still works).
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── CORS Origins ───────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase Auth (JWT verification, server-side only) ─────────────────────
# JWT secret from Supabase dashboard > Settings > API > JWT Settings.
# Never expose the secret to the browser or frontend.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# ── Firecrawl ──────────────────────────────────────────────────────────────
# Server-side only. Never set in frontend code or NEXT_PUBLIC_ variables.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_SECONDS=30
FIRECRAWL_VALIDATE_LIVE=false

# ── Credential Encryption (AES-256-GCM) ────────────────────────────────────
# 32-byte hex key (64 hex characters), e.g.: openssl rand -hex 32
FIRECRAWL_ENCRYPTION_KEY=

# ── Opportunity Discovery ──────────────────────────────────────────────────
# Per-user limits and safety controls. Supported domains must be comma-separated.
DISCOVERY_MAX_RESULTS=20
DISCOVERY_DEFAULT_RESULTS=20
DISCOVERY_MAX_CONCURRENT_JOBS=2
DISCOVERY_DAILY_QUOTA=10
DISCOVERY_MAX_DOMAINS=8
DISCOVERY_SUPPORTED_DOMAINS=linkedin.com,wellfound.com,remoteok.com,workatastartup.com,internshala.com,upwork.com,freelancer.com,greenhouse.io,lever.co
DISCOVERY_POLL_SECONDS=5
DISCOVERY_MAX_WAIT_SECONDS=300
DISCOVERY_MAX_RESPONSE_BYTES=200000
DISCOVERY_MAX_STORED_RESULTS=60
DISCOVERY_MAX_RETRIES=2
