# ── OpportunityHunter AI — Frontend Environment Template ───────────────────
# Copy to ".env.local" in the frontend directory.
# Only public, non-sensitive variables should be prefixed with NEXT_PUBLIC_.
# NEVER expose backend secrets, service keys, JWT secrets, or encryption keys here.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
